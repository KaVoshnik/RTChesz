# --- Обязательное ---
DATABASE_URL=postgres://rtchesz:change_local@localhost:5433/rtchesz

# Секрет подписи токенов (минимум 32 символа). Сгенерировать: openssl rand -hex 32
JWT_SECRET=dev_only_secret_change_me_0123456789abcdef

# --- Сервер ---
HOST=127.0.0.1
PORT=3000

# Адреса фронта через запятую (CORS). По умолчанию - dev-сервер Vite.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Включать только если перед API стоит доверенный прокси (nginx и т.п.),
# который сам дописывает X-Forwarded-For. Иначе клиент сможет подделать свой IP.
TRUST_PROXY=false

# --- Токены и восстановление пароля (значения по умолчанию) ---
# JWT_TTL_HOURS=168
# RESET_CODE_TTL_MINUTES=10
# RESET_TOKEN_TTL_MINUTES=15
# RESET_RESEND_COOLDOWN_SECS=60
# RESET_MAX_ATTEMPTS=5

# --- Почта ---
# Пока SMTP_HOST не задан, письма НЕ отправляются: код восстановления печатается в лог API.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls   # none | starttls | tls
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=RTChesz <no-reply@example.com>

# Логи: RUST_LOG=rtchesz_api=debug,tower_http=debug
