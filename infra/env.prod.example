# Ваш домен без http:// и без www
DOMAIN=rtchesz.ru

# База. Пароль только из букв и цифр (он вставляется в строку подключения).
# Сгенерировать:  openssl rand -hex 24
POSTGRES_DB=rtchesz
POSTGRES_USER=rtchesz
POSTGRES_PASSWORD=

# Секрет подписи токенов (мин. 32 символа).  Сгенерировать:  openssl rand -hex 32
JWT_SECRET=

# --- Почта (необязательно). Пока SMTP_HOST пуст, письма не уходят,
# а код восстановления пароля печатается в лог API: docker compose logs api
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=RTChesz <no-reply@rtchesz.ru>
